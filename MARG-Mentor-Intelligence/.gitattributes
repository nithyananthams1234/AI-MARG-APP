# Normalise line endings: LF in the repository and working tree for all text files,
# so diffs are identical on Windows, Linux and CI. Python, Markdown, TOML, SQL and
# Alembic files all work with LF on Windows.
* text=auto eol=lf

# Windows-native scripts must keep CRLF to run correctly.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.sqlite3 binary
*.db   binary
