# MARG production configuration. Copy to deploy/.env on the server (chmod 600).
# NEVER commit the real file. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Public hostname (DNS A record -> server IP) and Let's Encrypt contact
MARG_DOMAIN=marg.example.org
ACME_EMAIL=admin@example.org

# PostgreSQL (internal only)
POSTGRES_SUPERUSER_PASSWORD=
MARG_DB_PASSWORD=
MIE_DB_PASSWORD=

# Backend
JWT_SECRET_KEY=

# Evidence object storage (S3-compatible: Cloudflare R2, AWS S3, Backblaze B2, MinIO)
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_EVIDENCE_BUCKET=marg-evidence
# Separate bucket for database backups
S3_BACKUP_BUCKET=marg-backups

# Service-to-service keys (random, distinct)
COACH_API_KEY=
MIE_ENGINE_API_KEY=
MIE_SERVICE_KEY=

# NVIDIA-hosted inference (server-side only; never expose this key in the frontend)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
COACH_NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
MIE_NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Classroom Coach
COACH_DATA_DIR=./data/classroom-coach

# Mentor Intelligence
MIE_AI_ENABLED=true
PSEUDONYMISATION_KEY=
LLM_DAILY_TOKEN_BUDGET_PER_MENTOR=200000
LLM_DAILY_TOKEN_BUDGET_GLOBAL=2000000
# Optional cost tracking, format "model=input_usd_per_mtok/output_usd_per_mtok"
LLM_PRICING=
