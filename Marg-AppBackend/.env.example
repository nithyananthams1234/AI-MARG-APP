# ---------------------------------------------------------------------------
# MARG backend configuration. Copy to .env and fill in real values.
# NEVER commit .env. All values below are placeholders.
# ---------------------------------------------------------------------------
APP_NAME=MARG Backend
# development | production   (production disables /docs and expects HTTPS origins)
APP_ENV=development
DEBUG=false
SQL_ECHO=false

# PostgreSQL (asyncpg driver). Use a dedicated least-privilege role in production.
DATABASE_URL=postgresql+asyncpg://marg_app:CHANGE_ME@localhost:5432/marg_db

# JWT signing secret: generate with  python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Comma-separated browser origins allowed by CORS (Expo web dev server, deployed web app)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Evidence storage: local disk for development; S3-compatible bucket in production
STORAGE_LOCAL_PATH=storage/evidence
MAX_UPLOAD_SIZE_MB=10
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_NAME=marg-evidence
STORAGE_REGION=ap-south-1

# ---------------------------------------------------------------------------
# AI integration (the frontend never receives any of these keys)
# ---------------------------------------------------------------------------
# classroom_coach (default): analysis by the MARG Classroom Coach service
# openai: legacy direct OpenAI path (requires AI_API_KEY)
AI_PROVIDER=classroom_coach
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_TIMEOUT_SECONDS=60
AI_INLINE_PROCESSING=true

# Classroom Coach service (educational LLM + RAG)
CLASSROOM_COACH_URL=http://localhost:8001
CLASSROOM_COACH_API_KEY=
CLASSROOM_COACH_TIMEOUT_SECONDS=180

# Mentor Intelligence Engine (Claude-based mentor workflow agents)
MENTOR_INTELLIGENCE_URL=http://localhost:8002
# = ENGINE_API_KEY of the Mentor Intelligence service
MENTOR_INTELLIGENCE_API_KEY=
# Key Mentor Intelligence presents to /integrations/mentor-intelligence/* (= its MARG_BACKEND_SERVICE_KEY)
MENTOR_INTELLIGENCE_SERVICE_KEY=
MENTOR_INTELLIGENCE_TIMEOUT_SECONDS=180
MENTOR_DEFAULT_TIMEZONE=Asia/Kolkata
MENTOR_DEFAULT_WORK_START=09:00
MENTOR_DEFAULT_WORK_END=17:00
MENTOR_DEFAULT_WORKING_DAYS=1,2,3,4,5,6
VISIT_DEFAULT_DURATION_MINUTES=180

# Reminder notifications (due tasks/visits/steps, follow-ups to verify)
REMINDERS_INLINE=true
REMINDERS_INTERVAL_MINUTES=10

# Evidence storage backend: local (development) | s3 (production)
STORAGE_BACKEND=local
