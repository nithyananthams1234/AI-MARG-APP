# MARG Mentor Intelligence Engine - example configuration
# Copy to .env and fill in. Never commit .env. All values are validated at startup.
# Real environment variables take precedence over .env values.

# --- Application -------------------------------------------------------------
APP_ENV=development                 # development | test | staging | production
LOG_LEVEL=INFO
LOG_FORMAT=console                  # json | console
DEFAULT_TIMEZONE=Asia/Kolkata       # development default; configurable
# ENGINE_API_KEY=                   # optional: uncomment and set a value to require header X-API-Key on /api/v1
#                                   (an empty ENGINE_API_KEY= line is rejected at startup)

# --- AI provider ---------------------------------------------------------------
AI_ENABLED=true                     # false = deterministic-only operation, no hosted model calls
AI_PROVIDER=nvidia                  # nvidia | anthropic | openrouter
NVIDIA_API_KEY=                     # NVIDIA API Catalog key; never put this in frontend configuration
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MAX_OUTPUT_TOKENS=16000
NVIDIA_TIMEOUT_SECONDS=120
NVIDIA_MAX_RETRIES=3
# Optional legacy providers (only needed when AI_PROVIDER selects them).
ANTHROPIC_API_KEY=                  # leave empty here if already set as a user environment variable
ANTHROPIC_MODEL=                    # required only when AI_PROVIDER=anthropic
ANTHROPIC_EFFORT=                   # optional: low | medium | high | xhigh | max (omitted if empty)
ANTHROPIC_MAX_OUTPUT_TOKENS=16000
ANTHROPIC_TIMEOUT_SECONDS=120
ANTHROPIC_MAX_RETRIES=3
# Server-side refusal fallback: "default" or "off". Supported by some models on the Claude API only;
# set "off" if your configured model does not support it.
ANTHROPIC_REFUSAL_FALLBACK=default

# Token budgets (0 = no hosted model calls for that scope)
LLM_DAILY_TOKEN_BUDGET_PER_MENTOR=200000
LLM_DAILY_TOKEN_BUDGET_GLOBAL=5000000
# Optional pricing for cost reports, USD per million tokens: <model>=<input>/<output>[;...]
# Without an entry for the model, cost is reported as null (never estimated). Verify current prices.
LLM_PRICING=

# --- Data protection -----------------------------------------------------------
# Required outside APP_ENV=test (at least 32 characters).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
PSEUDONYMISATION_KEY=

# --- Engine database (engine-owned DB only, NEVER the MARG database) --------------
DB_BACKEND=postgres                 # postgres | sqlite (sqlite = local development fallback only)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marg_mentor_intelligence
DB_USER=marg_mie_app                # application role; never the postgres superuser
DB_PASSWORD=                        # never logged; separate fields avoid URL-encoding issues
DB_SCHEMA=mie
DB_TEST_SCHEMA=mie_test
DB_FORBIDDEN_NAMES=marg_db,postgres,template0,template1
SQLITE_PATH=./mie_dev.sqlite3       # used only when DB_BACKEND=sqlite

# --- MARG backend integration ---------------------------------------------------
BACKEND_MODE=demo                   # demo (DEMO DATA, development only). "marg" is refused until the audit.

# --- Provisional identity (development only) ------------------------------------
# Callers send X-Actor-Ref (and optionally X-Actor-Role). Must be false in staging/production.
DEV_AUTH_HEADER_ENABLED=true
DEV_SUPERVISOR_ROLES=dev_supervisor # placeholder role names until the MARG audit

# --- Planning parameters ---------------------------------------------------------
DEADLINE_HORIZON_DAYS=14
DEPENDENCY_POINTS_PER_BLOCKED_TASK=25
WORKLOAD_HIGH_THRESHOLD=80
WORKLOAD_OVERLOAD_THRESHOLD=100
VISIT_DURATION_MINUTES=180          # planning assumption for visit slot suggestions; empty = no suggestions
PROPOSAL_TTL_HOURS=72

# ---------------------------------------------------------------------------
# Service authentication and MARG backend integration
# ---------------------------------------------------------------------------
# Required for every /api/v1 request (the MARG backend sends it as X-API-Key).
ENGINE_API_KEY=
# Accept the mentor identity asserted by the MARG backend (requires ENGINE_API_KEY).
# Use this in staging/production; DEV_AUTH_HEADER_ENABLED must then be false.
TRUSTED_GATEWAY_IDENTITY=false
# BACKEND_MODE=marg reads/writes real MARG data through the backend service API.
MARG_BACKEND_URL=http://localhost:8000
# Must equal MENTOR_INTELLIGENCE_SERVICE_KEY in the backend configuration.
MARG_BACKEND_SERVICE_KEY=
MARG_BACKEND_TIMEOUT_SECONDS=30
