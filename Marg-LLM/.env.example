# MARG Classroom Coach configuration (copy to .env). No secrets are committed.
APP_NAME=MARG Classroom Coach
# development | production   (production requires COACH_API_KEY and NVIDIA_API_KEY; disables /docs)
APP_ENV=development

# NVIDIA-hosted OpenAI-compatible inference
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TIMEOUT_SECONDS=180
NVIDIA_TEMPERATURE=0.2
NVIDIA_MAX_ANSWER_TOKENS=900
NVIDIA_MAX_ANALYSIS_TOKENS=2600

# Embeddings + vector store (do not change the embedding model without re-ingesting)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=./data/chroma_db
COLLECTION_NAME=marg_classroom_knowledge
PDF_DIRECTORY=./data/pdfs
TITLE_MAPPING_FILE=./data/pdfs/rename_mapping.csv

# Retrieval tuning (cosine distance; calibrated on this knowledge base)
RETRIEVAL_TOP_K=5
RETRIEVAL_FETCH_K=30
RETRIEVAL_MAX_DISTANCE=0.60
RETRIEVAL_MAX_PER_DOCUMENT=2

# Service-to-service key; must equal CLASSROOM_COACH_API_KEY in the backend.
COACH_API_KEY=
